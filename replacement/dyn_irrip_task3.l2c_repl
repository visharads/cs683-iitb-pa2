#include "cache.h"
#include <random>
#include <iostream>

// hyperparms

#define maxRRPV 3
#define DATA_PROMOTE_PERCENT 8


#define LEADER_SET_MASK 0x3F  //1 out of every 64 sets acts as leader sets
#define TURN_ON_THRESH 20     //I-RRIP turns on when it reaches TURN_ON_THRES
#define TURN_OFF_THRESH 15    //I-RRIP turns off when it reaches TURN_OFF_THRES

#define MISS_WEIGHT 1

//Sampling counters decay
#define EPOCH_LIMIT 4096     

// states
uint32_t l2_rrpv[L2C_SET][L2C_WAY]; //2-bit rrip bits
bool is_prefetch[L2C_SET][L2C_WAY]; // Metadata to track prefetch lines laterally

uint32_t instr_access_count = 0;
uint32_t instr_miss_count = 0;
uint32_t total_access_count = 0;
uint32_t total_miss_count = 0;

static bool global_use_irrip = false;
static uint64_t num_switches = 0;   // number of mode changes (for the final stats)

static std::mt19937 irrip_rng(683);
static std::uniform_int_distribution<int> irrip_percent(0, 99);

// helper functions
inline bool is_leader_set(uint32_t set) {
    return (set & LEADER_SET_MASK) == 0;
}

//decides to turn I-RRIP on or OFF
inline void evaluate_phase() {
    uint32_t i_score = instr_access_count + (instr_miss_count * MISS_WEIGHT);
    uint32_t t_score = total_access_count + (total_miss_count * MISS_WEIGHT);

    if (t_score == 0) return;

    uint32_t percent = (i_score * 100) / t_score;

    if (global_use_irrip) {
        if (percent < TURN_OFF_THRESH) { global_use_irrip = false; num_switches++; }
    } else {
        if (percent >= TURN_ON_THRESH) { global_use_irrip = true; num_switches++; }
    }
}

void CACHE::l2c_initialize_replacement(){
    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            is_prefetch[i][j] = false;
        }
    }
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    bool use_irrip = global_use_irrip && !is_leader_set(set);

    while (1)
    {
        if (use_irrip) {
            // I-RRIP Pass 1: Evict dead demand DATA lines first
            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction && !is_prefetch[set][i])
                    return i;
            }
            // I-RRIP Pass 2: Evict PREFETCHED data lines next
            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction && is_prefetch[set][i])
                    return i;
            }
        } else {
            // SRRIP Pass 1: Evict non-prefetches first
            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && !is_prefetch[set][i])
                    return i;
            }
            // SRRIP Pass 2: Evict prefetches
            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && is_prefetch[set][i])
                    return i;
            }
        }

        // Final Pass: Any line at maxRRPV (This is where instructions are evicted)
        for (int i=0; i<L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV)
                return i;
        }

        // Age all lines
        for (int i=0; i<L2C_WAY; i++) {
            l2_rrpv[set][i]++;
        }
    }
    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    // Tracking Leader Sets 
    // Exclude PREFETCH and WRITEBACK from tracking
    if (is_leader_set(set) && type != PREFETCH && type != WRITEBACK) {
        total_access_count++;
        if (isInstruction) instr_access_count++;

        if (!hit) {
            total_miss_count++;
            if (isInstruction) instr_miss_count++;
        }
        
        evaluate_phase(); 
        
        //exponentially decay old history
        if ((total_access_count + total_miss_count) >= EPOCH_LIMIT) {
            total_access_count >>= 1;
            total_miss_count >>= 1;
            instr_access_count >>= 1;
            instr_miss_count >>= 1;
        }
    }

    bool use_irrip = global_use_irrip && !is_leader_set(set);

    // Update State
    if (hit) {
        if (type == WRITEBACK || type == PREFETCH) return; // Do not promote

        // Demand Hit Promotion
        if (use_irrip) {
            if (isInstruction) {
                l2_rrpv[set][way] = 0;  
            } else {
                if (irrip_percent(irrip_rng) < DATA_PROMOTE_PERCENT)
                    l2_rrpv[set][way] = 0;  
            }
        } else {
            l2_rrpv[set][way] = 0;
        }
        
        // demand hit turns a prefetch into a demand line
        is_prefetch[set][way] = false; 
    } 
    else { 
        // Track if this new line is a prefetch
        is_prefetch[set][way] = (type == PREFETCH);

        // Insertion Policy
        if (type == PREFETCH) {
            // Reverted to maxRRPV (3) to prevent crowding out instruction lines
            l2_rrpv[set][way] = maxRRPV; 
        }
        else if (use_irrip) {
            l2_rrpv[set][way] = isInstruction ? (maxRRPV - 1) : maxRRPV;
        } else {
            l2_rrpv[set][way] = maxRRPV - 1;
        }
    }
}

void CACHE::l2c_replacement_final_stats(){
}