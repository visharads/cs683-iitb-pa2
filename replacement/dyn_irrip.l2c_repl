#include "cache.h"
#include <random>

// Dynamic I-RRIP with one leader group (the spec's hint).
//   RRIP leader sets : always SRRIP (insert at RRPV 2, hit -> RRPV 0, evict first line at maxRRPV)
//   follower sets    : I-RRIP if the metric of the RRIP leaders is more than T, else SRRIP
// There are no I-RRIP leader sets.

// ================= design options =================
// Metric of the RRIP leader sets
#define M_MISS_RATE 1   // instr misses / instr accesses
#define M_SPEC      2   // (instr accesses + instr misses) / (total accesses + total misses)

// ----- selected options -----
#define METRIC_OPTION   M_MISS_RATE

// ----- parameters -----
#define NUM_LEADER_SETS 64          // RRIP leader sets
#define T               0.25        // metric > T: followers use I-RRIP, metric < T: followers use SRRIP
#define EPOCH_N         32          // leader LOAD accesses in each epoch
#define KEEP            0.5         // counters are multiplied by KEEP after each decision (0.5 = halve, 0 = reset)

// policy of the follower sets at the start of the simulation
#define POLICY_RRIP  0
#define POLICY_IRRIP 1
#define INITIAL_FOLLOWER_POLICY POLICY_RRIP
// ==================================================

#define maxRRPV 3
#define DATA_PROMOTE_PERCENT 8
uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// private fixed-seed random number generator for probabilistic data promotion.
// It is separate from rand(), because page_table_walker.cc uses rand() to map pages:
// sharing it would change the physical memory layout and not only this policy.
static std::mt19937 irrip_rng(683);
static std::uniform_int_distribution<int> irrip_percent(0, 99);   // uniform 0..99

// ---------------- leader sets ----------------
// the first set in each block of LEADER_GAP sets is an RRIP leader
#define LEADER_GAP (L2C_SET / NUM_LEADER_SETS)

static bool is_leader(uint32_t set)
{
    return (set % LEADER_GAP) == 0;
}

// ---------------- leader set counters ----------------
// Only LOAD requests are counted, the same as the L2C INSTRUCTION / DATA LOAD MPKI
// in main.cc (roi_miss[cpu][0], roi_instr_miss[cpu][0]): no RFO, writeback or translation requests.
static double instr_access, instr_miss;       // epoch counters (multiplied by KEEP, so double)
static double data_access,  data_miss;
static uint64_t epoch_accesses;               // leader LOAD accesses in the current epoch

static int follower_policy = INITIAL_FOLLOWER_POLICY;

// statistics for the whole run (never halved or reset)
static uint64_t total_instr_access, total_instr_miss, total_data_access, total_data_miss;
static uint64_t num_decisions, num_switches;
static uint64_t follower_load_access[2];      // follower LOAD accesses while in RRIP / I-RRIP mode

// ---------------- SRRIP rules ----------------
static uint32_t rrip_find_victim(uint32_t set)
{
    // evict the first line at maxRRPV
    while (1)
    {
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        // no line at maxRRPV: age all lines
        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }
}

static void rrip_update(uint32_t set, uint32_t way, uint8_t hit)
{
    if (hit)
        l2_rrpv[set][way] = 0;              // hit priority
    else
        l2_rrpv[set][way] = maxRRPV-1;      // insert at RRPV 2
}

// ---------------- I-RRIP rules (Task 2A) ----------------
static uint32_t irrip_find_victim(uint32_t set, const BLOCK *current_set)
{
    // among the lines at maxRRPV, evict a data line first
    while (1)
    {
        // pass 1: data line at maxRRPV
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction)
                return i;

        // pass 2: any line at maxRRPV (only instruction lines are left)
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        // no line at maxRRPV: age all lines (same as SRRIP)
        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }
}

static void irrip_update(uint32_t set, uint32_t way, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if (hit) {
        // a writeback hit is not a demand reuse: keep the RRPV
        if (type == WRITEBACK)
            return;

        if (isInstruction)
            l2_rrpv[set][way] = 0;      // instruction hit: full protection
        else
        {
            // data hit: promote with a small probability, so that only data lines
            // with many hits (frequent reuse) are likely to get full protection
            if (irrip_percent(irrip_rng) < DATA_PROMOTE_PERCENT)
                l2_rrpv[set][way] = 0;
        }
    }
    else {
        // fill: instruction lines at RRPV 2, data lines at maxRRPV (next victims if not reused)
        l2_rrpv[set][way] = isInstruction ? maxRRPV-1 : maxRRPV;
    }
}

// ---------------- decision ----------------
// metric of the RRIP leader sets
static double leader_metric()
{
#if METRIC_OPTION == M_MISS_RATE
    return (instr_access > 0) ? instr_miss / instr_access : 0;
#elif METRIC_OPTION == M_SPEC
    double total = instr_access + data_access + instr_miss + data_miss;
    return (total > 0) ? (instr_access + instr_miss) / total : 0;
#else
#error "unknown METRIC_OPTION"
#endif
}

// end of an epoch: compare the metric with T, then decay the counters
static void end_epoch()
{
    double m = leader_metric();
    int selected = follower_policy;
    if (m > T)
        selected = POLICY_IRRIP;
    else if (m < T)
        selected = POLICY_RRIP;

    num_decisions++;
    if (selected != follower_policy) {
        follower_policy = selected;
        num_switches++;
    }

    instr_access *= KEEP;  instr_miss *= KEEP;
    data_access  *= KEEP;  data_miss  *= KEEP;
    epoch_accesses = 0;
}

// count one LOAD access of a leader set
static void count_leader_load(uint8_t hit, uint8_t isInstruction)
{
    // A fill (hit == 0) occurs only after a miss, so each fill is one miss.
    if (isInstruction) {
        instr_access++;            total_instr_access++;
        if (!hit) { instr_miss++;  total_instr_miss++; }
    } else {
        data_access++;             total_data_access++;
        if (!hit) { data_miss++;   total_data_miss++; }
    }

    if (++epoch_accesses >= EPOCH_N)
        end_epoch();
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize dynamic IRRIP (one leader group) state for L2C: metric " << METRIC_OPTION
         << ", T " << T << ", " << NUM_LEADER_SETS << " RRIP leader sets, EPOCH_N " << EPOCH_N
         << ", KEEP " << KEEP << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }

    instr_access = instr_miss = data_access = data_miss = 0;
    total_instr_access = total_instr_miss = total_data_access = total_data_miss = 0;
    epoch_accesses = 0;
    num_decisions = num_switches = 0;
    follower_load_access[0] = follower_load_access[1] = 0;
    follower_policy = INITIAL_FOLLOWER_POLICY;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    if (is_leader(set) || follower_policy == POLICY_RRIP)
        return rrip_find_victim(set);

    return irrip_find_victim(set, current_set);
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    bool leader = is_leader(set);

    if (type == LOAD) {
        if (leader)
            count_leader_load(hit, isInstruction);
        else
            follower_load_access[follower_policy]++;
    }

    // leader sets always use SRRIP, follower sets use the selected policy
    if (leader || follower_policy == POLICY_RRIP)
        rrip_update(set, way, hit);
    else
        irrip_update(set, way, type, hit, isInstruction);
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "L2C RRIP leaders: instr access " << total_instr_access << " instr miss " << total_instr_miss
         << " data access " << total_data_access << " data miss " << total_data_miss << endl;
    uint64_t fol = follower_load_access[0] + follower_load_access[1];
    cout << "L2C dynamic IRRIP: decisions " << num_decisions << " switches " << num_switches
         << " follower LOAD accesses in I-RRIP mode " << follower_load_access[POLICY_IRRIP]
         << " (" << (fol ? 100.0 * follower_load_access[POLICY_IRRIP] / fol : 0) << "%)" << endl;
}
